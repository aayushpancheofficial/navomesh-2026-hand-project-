# NAVONMESH 26 AI Prosthetic Hand - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your Windows 11 machine.

# Arduino Mega Serial COM Port (Default on Windows is typically COM3, COM4, COM5)
ARDUINO_PORT=COM3
BAUD_RATE=115200

# Local Flask Web Server Port
FLASK_PORT=5000

# Default Hardware USB Webcam Index (0 = primary built-in or USB webcam)
DEFAULT_CAMERA_INDEX=0

# Safety: Exclude Person / Human from being targeted or grasped by the prosthetic hand (true / false)
EXCLUDE_PERSON=true

# Optional: OpenAI Vision API Key (Enables advanced cloud-based grasp & material analysis)
# Leave blank to use 100% offline local YOLOv8 detection
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

